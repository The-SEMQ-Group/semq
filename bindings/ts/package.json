{
  "name": "@semq/sdk",
  "version": "1.0.0",
  "description": "TypeScript binding for the SEMQ codec, compiled to WebAssembly.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-SEMQ-Group/semq.git",
    "directory": "bindings/ts"
  },
  "homepage": "https://github.com/The-SEMQ-Group/semq#readme",
  "bugs": "https://github.com/The-SEMQ-Group/semq/issues",
  "keywords": [
    "embeddings",
    "quantization",
    "vectors",
    "determinism",
    "webassembly"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:ts": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "build": "npm run build:wasm && npm run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "docs": "typedoc --options typedoc.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.3",
    "@types/node": "^22.20.4",
    "eslint": "10.12.0",
    "publint": "0.3.25",
    "typedoc": "0.28.20",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.2"
  }
}
